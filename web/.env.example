# Base URL for the gocha API. Empty = same-origin (use the Vite dev proxy).
# See vite.config.ts for the dev proxy target (default http://localhost:8080).
VITE_API_URL=

# XMPP websocket endpoint the SPA connects to after signing in, using the chat
# credentials the API returns (xmpp_username/xmpp_password). Empty = no chat
# connection. Must match the server's ethora.xmpp_ws_url.
VITE_ETHORA_WS=wss://xmpp.chat.ethora.com/ws
