# The API base URL used by axios (see src/api/client.ts). Set to the Go
# server's address so the SPA calls it directly, cross-origin — the backend
# now sends CORS headers (server.allowed_origins), so no Vite dev proxy is
# needed. Override the target with APP_PORT/config.yaml if the server moves.
VITE_API_URL=http://localhost:8080
